# Copy this file to .env, fill in one model backend, then load it:
#   cp .env.example .env
#   set -a; source .env; set +a
#
# .env is ignored by git. Never put a real API key in this example file.

# -----------------------------------------------------------------------------
# ECom-style tool planning
# Requires either the DeepSeek backend or the local backend below.
# -----------------------------------------------------------------------------
SHOPPING_AGENT_TOOL_PLANNING_ENABLED=true
SHOPPING_AGENT_TOOL_MAX_STEPS=4
SHOPPING_AGENT_TOOL_TIMEOUT_SECONDS=30

# Shared model request settings.
SHOPPING_AGENT_MODEL_TIMEOUT_SECONDS=8
SHOPPING_AGENT_MODEL_MAX_TOKENS=1024
SHOPPING_AGENT_MODEL_TEMPERATURE=0

# -----------------------------------------------------------------------------
# DeepSeek API backend
# Leave the key empty if you only use a local model.
# -----------------------------------------------------------------------------
SHOPPING_AGENT_DEEPSEEK_API_KEY=
SHOPPING_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
SHOPPING_AGENT_DEEPSEEK_MODEL=deepseek-v4-flash

# -----------------------------------------------------------------------------
# Local OpenAI-compatible backend
# Both BASE_URL and MODEL are required to enable it. API_KEY is optional.
# If DeepSeek is also configured, the local backend is used as fallback.
# -----------------------------------------------------------------------------
SHOPPING_AGENT_LOCAL_BASE_URL=
SHOPPING_AGENT_LOCAL_MODEL=
SHOPPING_AGENT_LOCAL_API_KEY=

# -----------------------------------------------------------------------------
# Retrieval and semantic-ranking limits
# -----------------------------------------------------------------------------
SHOPPING_AGENT_RETRIEVAL_LIMIT=100
SHOPPING_AGENT_MODEL_CANDIDATE_LIMIT=30

# -----------------------------------------------------------------------------
# Optional local Qwen reranker
# This is separate from the tool-planning model and is not required for a
# tool-loop smoke test. The path must be absolute to enable it.
# -----------------------------------------------------------------------------
SHOPPING_AGENT_QWEN_RERANKER_MODEL_PATH=
SHOPPING_AGENT_QWEN_RERANKER_REVISION=
SHOPPING_AGENT_QWEN_RERANKER_DEVICE=cpu
SHOPPING_AGENT_QWEN_RERANKER_BATCH_SIZE=8
SHOPPING_AGENT_QWEN_RERANKER_CANDIDATE_LIMIT=30
SHOPPING_AGENT_QWEN_RERANKER_TIMEOUT_SECONDS=15
SHOPPING_AGENT_QWEN_RERANKER_FUSION_WEIGHT=1.0
