# Copy to .env, set only the backends available on this machine, then load it:
#   set -a; source .env; set +a
#
# The intent model is opt-in.  Leave it false to use the offline deterministic
# parser only.  Never commit a real API key.
SHOPPING_AGENT_INTENT_MODEL_ENABLED=false
SHOPPING_AGENT_INTENT_MODEL_TRIGGER_THRESHOLD=0.72
SHOPPING_AGENT_INTENT_MODEL_ACCEPT_THRESHOLD=0.65
SHOPPING_AGENT_INTENT_MODEL_RECENT_TURNS=4

# Tier 1: DeepSeek API.  Set the key to enable this tier.
SHOPPING_AGENT_DEEPSEEK_API_KEY=
SHOPPING_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
SHOPPING_AGENT_DEEPSEEK_MODEL=deepseek-v4-flash

# Tier 2: local OpenAI-compatible server.  Both URL and model are required.
SHOPPING_AGENT_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
SHOPPING_AGENT_LOCAL_MODEL=
SHOPPING_AGENT_LOCAL_API_KEY=

# Shared API/local request budget.
SHOPPING_AGENT_MODEL_TIMEOUT_SECONDS=8
SHOPPING_AGENT_MODEL_MAX_TOKENS=512
SHOPPING_AGENT_MODEL_TEMPERATURE=0
